# Credentials. Both are read at run time from the environment or these files;
# neither has ever been committed, and neither should be. .env holds FAL_KEY,
# which bills real money, and .qwen_key is the model server's API key.
.env
.env.docker
.qwen_key

# The virtualenv. requirements.txt pins the exact versions it was built from,
# so it is reproducible - and it is 164MB of platform-specific binaries that
# would be wrong on any machine but this one.
.venv/
__pycache__/
*.py[cod]

# Run output. 203MB and growing: every run archives ten ~5MB candidate PNGs
# plus the picks. The transcript and LOG.md are worth keeping for a run you
# care about - copy those out rather than committing the folder.
runs/

# Left over from the retired reference matcher's attribute cache. Nothing writes
# it any more; ignored so an old working copy stays clean.
.cache/

# Working photos. Per-job, 6-16MB each - the garment to lay out and the
# reference to lay it against. Both are run inputs rather than source, and the
# harness writes derived copies beside them. The directory itself is kept.
inputs/*
!inputs/.gitkeep

# Where the container delivers best.png. See DOCKER.md.
out/

# Bulk archives - inputs.zip alone is 28MB of photos already covered above.
*.zip

.DS_Store
