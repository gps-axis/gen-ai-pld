# Copy to .env.docker and fill in. run-docker.sh loads this, then .env.
#
# Required unless LAYDOWN_MAX_IMAGES=0. Bills real money at fal.ai.
FAL_KEY=

# The model server's key. Read from .qwen_key on the host; the container is
# never given that file, so it is passed in.
QWEN_API_KEY=pick-a-long-secret-string

# Optional overrides.
#
# QWEN_BASE_URL takes NO /v1 suffix - harness.py appends it. A /v1 on the end
# is stripped, so pasting the endpoint in either form works.
#QWEN_BASE_URL=http://10.11.245.41:8091
#
# The model to route on. Leave unset against a server holding one model - the
# harness then uses whatever /v1/models lists. Required against a proxy such as
# LiteLLM, which fronts several and rejects a request that names none.
#QWEN_MODEL=vision-qwen
#
# The SAM3 segmentation service. Drops the background only; a tag or pin
# attached to the garment survives into the source image. Behind the proxy it
# needs a key of its own - the model's key is not valid on this route.
#SEGMENT_URL=http://10.11.245.145:4000/sam3-segment
#SEGMENT_API_KEY=
#
# fal.ai images for the whole run. 0 runs the loop and bills nothing, which is
# how to smoke-test a deployment for free.
#LAYDOWN_MAX_IMAGES=10
#
# The reference laydown to aim at. Defaults to whatever matches /in/reference*.
#REFERENCE=/in/reference_greyscale.jpg
